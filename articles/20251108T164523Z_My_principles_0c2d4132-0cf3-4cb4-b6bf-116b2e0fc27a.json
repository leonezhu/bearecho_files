          "start_time": 11.616,
          "end_time": 15.456,
          "language": "source"
        },
        {
          "text": "\n",
          "start_time": 44.68800000000001,
          "end_time": 44.68800000000001,
          "language": "en"
        },
        {
          "text": "I work hard before allowing myself to enjoy.",
