          "end_time": 11.616,
          "language": "source"
        },
        {
          "text": "\n",
          "start_time": 44.68800000000001,
          "end_time": 44.68800000000001,
          "language": "en"
        },
        {
          "text": "I'm a long-term thinker who focuses on lasting value.",
          "start_time": 11.616,
          "end_time": 15.456,
          "language": "en"
        },
        {
          "text": "\n",
          "start_time": 44.68800000000001,
          "end_time": 44.68800000000001,
          "language": "en"
        },
        {
