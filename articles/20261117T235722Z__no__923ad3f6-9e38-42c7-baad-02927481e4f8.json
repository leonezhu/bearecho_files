          "language": "yue"
        },
        {
          "text": "\n",
          "start_time": 49.367999999999995,
          "end_time": 49.367999999999995,
          "language": "yue"
        },
        {
          "text": "At this point, what I actually use is WeChat and X — the rest I barely touch.",
          "start_time": 37.344,
